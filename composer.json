{
    "name": "testflowlabs/doctest",
    "description": "A PHP documentation testing tool that validates code examples in markdown files",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "league/commonmark": "^2.0",
        "symfony/console": "^7.0 || ^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-type-coverage": "^3.6",
        "phpstan/phpstan": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "TestFlowLabs\\DocTest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TestFlowLabs\\DocTest\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/doctest"
    ],
    "scripts": {
        "rector": "rector",
        "pint": "pint --config=pint.json",
        "test:rector": "rector --dry-run",
        "test:pint": "pint --config=pint.json --test",
        "test:phpstan": "phpstan analyse --configuration=phpstan.neon --ansi",
        "test:unit": "pest --parallel --colors=always --order-by=random",
        "test:types": "pest --type-coverage --colors=always",
        "test:coverage": "pest --coverage --colors=always --min=80",
        "test:profile": "pest --profile --colors=always --order-by=random",
        "test:mutation": "pest --mutate --parallel --everything",
        "test:doc": "php bin/doctest --parallel",
        "test": [
            "@test:rector",
            "@test:pint",
            "@test:phpstan",
            "@test:unit",
            "@test:types",
            "@test:doc"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
